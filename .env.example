# Скопируйте этот файл в .env.local и вставьте свои значения из Supabase
# (Project Settings → API). Файл .env.local в Git не попадает.

# Адрес проекта, выглядит как https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Публичный ключ (publishable key, начинается с sb_publishable_).
# Его можно показывать в браузере — доступ к данным ограничивают правила RLS в базе.
# НИКОГДА не вставляйте сюда secret / service_role ключ.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
